APP_NAME="Personal AI Social Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=social_assistant
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Social Media OAuth Credentials
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI="${APP_URL}/api/v1/accounts/oauth/x_twitter/callback"
TWITTER_CLIENT_ID="${X_CLIENT_ID}"
TWITTER_CLIENT_SECRET="${X_CLIENT_SECRET}"

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/api/v1/accounts/oauth/linkedin/callback"

# Multi-Model AI API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=

# API Cost Guardrails ($ USD)
DAILY_BUDGET_CAP_USD=10.00
MONTHLY_BUDGET_CAP_USD=150.00
DAILY_LLM_BUDGET_USD=10.00
MONTHLY_LLM_BUDGET_USD=150.00
DAILY_MEDIA_BUDGET_USD=15.00
MONTHLY_MEDIA_BUDGET_USD=200.00
DAILY_X_POST_LIMIT=50
